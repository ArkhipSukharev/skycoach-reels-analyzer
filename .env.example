# Обязательные ключи
# LLM — один из вариантов:
#  1) AI Tunnel (рекомендуется): ключ https://aitunnel.ru,
#     GEMINI_BASE_URL=https://api.aitunnel.ru/v1, LLM_API_STYLE=openai
#  2) напрямую у Google: ключ https://aistudio.google.com/apikey, GEMINI_BASE_URL пустой;
#  3) ProxyAPI: ключ https://console.proxyapi.ru, GEMINI_BASE_URL=https://api.proxyapi.ru
GEMINI_API_KEY=
GEMINI_BASE_URL=https://api.aitunnel.ru/v1
LLM_API_STYLE=openai
# Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Необязательные настройки (значения по умолчанию указаны справа)
# GEMINI_MODEL=gemini-3.8-flash
# Модели, на которые переключаемся при перегрузке основной (ошибки 503/429)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# Разрешение кадров для модели: MEDIA_RESOLUTION_LOW / MEDIUM / HIGH
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
# Цена за 1M токенов — для оценки стоимости в интерфейсе.
# AI Tunnel Gemini 3.8 Flash: 150 / 750 / ₽
# GEMINI_PRICE_INPUT_PER_M=150
# GEMINI_PRICE_OUTPUT_PER_M=750
# GEMINI_PRICE_CURRENCY=₽
# Каскад: кадры сначала на дешёвой модели, при пограничном результате — перепроверка
# GEMINI_CASCADE=false
# GEMINI_CHEAP_MODEL=gemini-3.1-flash-lite
# GEMINI_CHEAP_PRICE_INPUT_PER_M=76
# GEMINI_CHEAP_PRICE_OUTPUT_PER_M=455
# Конвейер: 0 = без лимита (до MAX_URLS_PER_REQUEST слотов на пул)
# PREP_CONCURRENCY=0
# AI_CONCURRENCY=3
# GEMINI_MAX_CONCURRENCY=3
# MAX_FRAMES=120
# MAX_VIDEO_SECONDS=1800
# Файл cookies Instagram (формат Netscape) для запасного скачивания через yt-dlp.
# Положите cookies.txt в корень проекта и раскомментируйте строку.
# INSTAGRAM_COOKIES_FILE=/app/cookies.txt
